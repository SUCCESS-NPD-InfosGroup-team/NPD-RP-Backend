# Server (Railway injects PORT automatically)
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Database, as seen from your machine (IDE runs / DB clients).
# Inside docker compose the api service always uses postgres:5432.
# 5433 avoids clashing with a locally installed PostgreSQL on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=npd_rp
DB_USER=npd_rp
DB_PASSWORD=change-me
