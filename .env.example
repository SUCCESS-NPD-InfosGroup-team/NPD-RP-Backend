# Server (Railway injects PORT automatically)
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Database, as seen from your machine (IDE runs / DB clients).
# Inside docker compose the api service always uses postgres:5432.
# 5433 avoids clashing with a locally installed PostgreSQL on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=npd_rp
DB_USER=npd_rp
DB_PASSWORD=change-me

# Dev mode: exposes OpenAPI (/v3/api-docs) and Scalar UI (/scalar).
# Must be false (or unset) on Railway production.
APP_DEV_MODE=true

# Keycloak realm that issues the access tokens (the "iss" claim of the token)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/npd

# Optional: Keycloak server for the user-management calls, only when the API cannot reach the issuer's
# address (inside the infra docker compose: http://keycloak:8080). Empty: taken from KEYCLOAK_ISSUER_URI
KEYCLOAK_ADMIN_URL=

# Service account the API uses to call the Keycloak Admin REST API (confidential client with
# "Service accounts roles"; see docs/specs/SCRUM-93/design.md). Secret from its Credentials tab.
KEYCLOAK_ADMIN_CLIENT_ID=npd-rp-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Invitation email: client_id of the frontend in Keycloak, and the frontend's base URL (the user lands
# on {APP_FRONTEND_URL}/recursos after setting the password; it must be a valid redirect URI of that client)
KEYCLOAK_FRONTEND_CLIENT_ID=change-me
APP_FRONTEND_URL=http://localhost:5173
